{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minimal EPUB Reader",
  "version": "0.1.0",
  "identifier": "com.minimal.epub.reader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minimal EPUB Reader",
        "width": 700,
        "height": 900,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB Document",
        "description": "EPUB电子书",
        "role": "Viewer"
      }
    ]
  }
}